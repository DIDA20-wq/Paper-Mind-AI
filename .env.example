# PaperMind AI Configuration
PROJECT_NAME="PaperMind AI"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Relational Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/papermind"
SQLITE_FALLBACK_URL="sqlite:///./papermind.db"

# Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="papermind_chunks"

# AI Inference & Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
